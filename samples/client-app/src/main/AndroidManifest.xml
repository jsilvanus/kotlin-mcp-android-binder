<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11+ hides other apps unless declared; this is what lets us bind to the provider. -->
    <queries>
        <package android:name="fi.italeino.mcp.sample.provider" />
    </queries>
    <application android:label="MCP sample client">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
